# Render.IA backend - variables de entorno.
# Copia este archivo a .env SOLO en tu máquina; .env está en .gitignore y nunca se sube.
# En Render se configuran en Environment. Todas las claves de ejemplo son falsas.

# --- Base de datos (Neon) ---
DB_URL=jdbc:postgresql://HOST.neon.tech/renderia?sslmode=require
DB_USERNAME=renderia_app
DB_PASSWORD=cambia-esto

# --- Sesiones (obligatoria en producción, mínimo 32 caracteres) ---
# Genera una con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=12

# --- URLs ---
FRONTEND_URL=http://localhost:5173,https://renderia-frontend.vercel.app
# Render la define sola; en local se usa http://localhost:8080
# RENDER_EXTERNAL_URL=https://renderia-backend.onrender.com

# --- Servicio de IA (repositorio renderia-ai) ---
AI_SERVICE_URL=http://localhost:8000
# La misma clave que AI_API_KEY en renderia-ai. Genera una con: openssl rand -hex 32
AI_API_KEY=
AI_KEEP_WARM=true

# --- Cuentas iniciales (opcionales) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_ACCOUNTS=true

# --- Solo si NO estás en Render y quieres comportamiento de producción ---
# APP_PRODUCTION=true
# BEHIND_PROXY=true
